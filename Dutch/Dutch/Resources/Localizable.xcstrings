    "%@ has spent %@. Open Dutch and touch and hold your own name to hear your own balance." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has spent %2$@. Open Dutch and touch and hold your own name to hear your own balance."
