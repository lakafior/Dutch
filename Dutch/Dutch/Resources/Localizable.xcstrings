    "reopenLastGroupExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Neustart öffnet Dutch die Gruppe, in der du zuletzt warst, statt der Gruppenliste. Bei der Rückkehr aus dem Hintergrund bleibst du, wo du warst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When Dutch starts fresh it opens the group you were last in, rather than the group list. Returning from the background leaves you wherever you were."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy Dutch uruchamia się od nowa, otwiera ostatnio otwartą grupę zamiast listy grup. Powrót z tła nie zmienia bieżącego ekranu."
          }
        },
        "pt-BR" : {
