    "nearbyAddressExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Cafés oder Restaurants in Gehweite, daher ist das die Straße, in der du bist. Du kannst sie wie jeden anderen Titel bearbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cafés or restaurants within a short walk, so this is the street you are on. You can edit it like any other title."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pobliżu nie ma kawiarni ani restauracji, więc to ulica, na której jesteś. Możesz ją edytować jak każdy inny tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há cafés ou restaurantes a uma curta caminhada, então esta é a rua em que você está. Você pode editá-la como qualquer outro título."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há cafés ou restaurantes a uma curta distância a pé, por isso esta é a rua em que estás. Podes editá-la como qualquer outro título."
          }
        }
      }
    },
    "nearbyNoFixExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät konnte seinen Standort nicht bestimmen. Dafür braucht es einen Moment im Freien oder einen nicht blockierten Standortzugriff – das Titelfeld funktioniert weiterhin wie immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone couldn't work out where it is. This needs a moment outdoors, or a location that isn't blocked — the title field still works as it always has."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon nie ustalił swojego położenia. Potrzeba chwili na zewnątrz albo odblokowanej lokalizacji — pole tytułu działa tak jak zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu aparelho não conseguiu determinar onde está. Isso precisa de um momento ao ar livre, ou de uma localização que não esteja bloqueada — o campo de título continua funcionando como sempre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu telemóvel não conseguiu determinar onde está. Isto precisa de um momento ao ar livre, ou de uma localização que não esteja bloqueada — o campo do título continua a funcionar como sempre."
          }
        }
      }
    },
    "nearbyNothingFoundExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Cafés oder Restaurants in Gehweite. Das Titelfeld unten funktioniert weiterhin wie immer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cafés or restaurants within a short walk. The title field below still works as it always has."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pobliżu nie ma kawiarni ani restauracji. Pole tytułu działa tak jak zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há cafés ou restaurantes a uma curta caminhada. O campo de título abaixo continua funcionando como sempre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há cafés ou restaurantes a uma curta distância a pé. O campo do título abaixo continua a funcionar como sempre."
          }
        }
      }
    },
    "nearbyPermissionExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch braucht Zugriff auf deinen Standort, bevor es Orte in der Nähe vorschlagen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch needs permission to read where you are before it can suggest places nearby."
