      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch couldn't reach Apple Maps. This needs a connection, so it won't work with roaming off — type a title instead."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch nie może połączyć się z Mapami Apple. Ta funkcja wymaga połączenia z internetem, więc nie zadziała przy wyłączonym roamingu — wpisz tytuł ręcznie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dutch não conseguiu conectar aos Mapas da Apple. Isso precisa de conexão, então não vai funcionar com o roaming desligado — digite um título manualmente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dutch não conseguiu ligar-se aos Mapas da Apple. Isto precisa de ligação, por isso não vai funcionar com o roaming desligado — escreve um título manualmente."
          }
        }
      }
