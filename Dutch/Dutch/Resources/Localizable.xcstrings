    "pricingDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Gruppe ist kostenlos. Schalte mit einem einmaligen Kauf unbegrenzt viele Gruppen frei – Gruppen anderer beizutreten ist immer kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One group is free. Unlock unlimited groups with a one-time purchase — joining other people's groups is always free."
