    "qrInvitationInstructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur eingeladene Personen können beitreten, daher reicht es nicht, diesen Code zu scannen oder den Link zu öffnen. Nutze „Personen einladen“ und erlaube dort allen mit dem Link den Beitritt."
          }
        },
        "en" : {
          "stringUnit" : {
