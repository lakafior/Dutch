    "qrInvitationInstructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only people you invite can join, so scanning this code or opening the link won't work on its own. Use Invite People, and allow anyone with the link from there."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołączyć mogą tylko osoby, które zaprosisz, więc samo zeskanowanie tego kodu ani otwarcie linku nie zadziała. Użyj opcji „Zaproś ludzi” i zezwól tam na dołączanie każdemu, kto ma link."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só quem você convidar pode entrar, então ler este código ou abrir o link sozinho não vai funcionar. Use Convidar pessoas e permita qualquer um com o link por lá."
