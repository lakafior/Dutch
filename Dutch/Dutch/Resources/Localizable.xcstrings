    },
    "locationExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch liest deinen Standort nur, wenn du bei einer Ausgabe auf „In der Nähe“ tippst – einmalig, um Orte in deiner Umgebung vorzuschlagen, oder die Straße, in der du bist, wenn keine gefunden werden. Nichts läuft im Hintergrund, und nichts wird in einer Gruppe gespeichert, außer du wählst etwas aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch reads where you are only when you tap Nearby on an expense — once, to suggest the places around you, or the street you are on when it finds none. Nothing runs in the background, and nothing is saved to a group unless you pick one."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch odczytuje Twoje położenie tylko wtedy, gdy dotkniesz przycisku „W pobliżu” przy wydatku — jednorazowo, aby zaproponować miejsca w okolicy, a gdy żadnego nie znajdzie, ulicę, na której jesteś. Nic nie działa w tle i nic nie jest zapisywane w grupie, dopóki czegoś nie wybierzesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dutch lê sua localização apenas quando você toca em Por perto em uma despesa — uma vez, para sugerir os lugares ao seu redor, ou a rua em que você está quando não encontra nenhum. Nada roda em segundo plano, e nada é salvo em um grupo a menos que você escolha algo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dutch lê a tua localização apenas quando tocas em Por perto numa despesa — uma vez, para sugerir os lugares à tua volta, ou a rua em que estás quando não encontra nenhum. Nada corre em segundo plano, e nada é guardado num grupo a não ser que escolhas algo."
          }
        }
      }
    },
