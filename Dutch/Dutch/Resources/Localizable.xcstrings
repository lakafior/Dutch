    "%@ has no members yet. Add one in Dutch first." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %@ nie ma jeszcze członków. Najpierw dodaj kogoś w Dutch."
          }
        }
      }
    },
    "%@ has spent %@. Open Dutch and touch and hold your own name to hear your own balance." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has spent %2$@. Open Dutch and touch and hold your own name to hear your own balance."
