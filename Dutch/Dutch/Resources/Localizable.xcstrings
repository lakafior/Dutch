    "newAdditionInstructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, die Dutch installiert haben, können diesen Code scannen oder den gesendeten Link öffnen, um beizutreten. Wer die App noch nicht hat, bekommt zuerst den App Store-Code gezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone with Dutch installed can scan this to join, or open the link you send them. If someone hasn't got the app yet, show them the App Store code first."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto ma zainstalowany Dutch, może zeskanować ten kod lub otworzyć wysłany link, aby dołączyć. Jeśli ktoś nie ma jeszcze aplikacji, pokaż mu najpierw kod do App Store."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com o Dutch instalado pode ler este código para entrar, ou abrir o link que você enviar. Se alguém ainda não tem o app, mostre primeiro o código da App Store."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com o Dutch instalado pode ler este código para se juntar, ou abrir o link que lhe enviares. Se alguém ainda não tem a app, mostra-lhe primeiro o código da App Store."
          }
        }
