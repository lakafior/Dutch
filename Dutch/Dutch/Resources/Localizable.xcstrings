    "contributionExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel diese Person beigesteuert hat. Lass das Feld leer, damit sie einen gleichen Teil von dem übernimmt, was die anderen nicht abdecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How much this person put in. Leave it blank to give them an equal part of whatever the others don't cover."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile dołożyła ta osoba. Zostaw puste, aby przypadła jej równa część tego, czego nie pokrywają pozostali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
