    },
    "%@ has spent %@. Open Dutch and touch and hold your own name to hear your own balance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat %2$@ ausgegeben. Öffne Dutch und halte deinen eigenen Namen gedrückt, um deinen eigenen Saldo zu hören."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has spent %2$@. Open Dutch and touch and hold your own name to hear your own balance."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa %1$@ wydała %2$@. Otwórz Dutch i przytrzymaj swoje imię, aby poznać własny bilans."
