    "%@ has joined but hasn't picked their name from this list yet." : {
      "comment" : "Footer under the member list. The placeholder is one name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist beigetreten, hat aber noch keinen Namen aus dieser Liste gewählt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dołączył(a), ale nie wybrał(a) jeszcze swojego imienia z tej listy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entrou, mas ainda não escolheu o nome nesta lista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ juntou-se, mas ainda não escolheu o nome nesta lista."
          }
        }
      }
    },
    "%@ has no members yet. Add one in Dutch first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keine Mitglieder. Füge zuerst in Dutch jemanden hinzu."
