    "%@ they were splitting gets divided between everyone left, so balances change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeinsame Ausgaben (%@) werden auf alle Übrigen aufgeteilt, daher ändern sich die Salden."
