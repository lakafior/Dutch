    "nearbyAddressExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No cafés or restaurants within a short walk, so this is the street you are on. You can edit it like any other title."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pobliżu nie ma kawiarni ani restauracji, więc to ulica, na której jesteś. Możesz ją edytować jak każdy inny tytuł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há cafés ou restaurantes a uma curta caminhada, então esta é a rua em que você está. Você pode editá-la como qualquer outro título."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há cafés ou restaurantes a uma curta distância a pé, por isso esta é a rua em que estás. Podes editá-la como qualquer outro título."
          }
        }
      }
    },
    "nearbyNoFixExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your phone couldn't work out where it is. This needs a moment outdoors, or a location that isn't blocked — the title field still works as it always has."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon nie ustalił swojego położenia. Potrzeba chwili na zewnątrz albo odblokowanej lokalizacji — pole tytułu działa tak jak zawsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu aparelho não conseguiu determinar onde está. Isso precisa de um momento ao ar livre, ou de uma localização que não esteja bloqueada — o campo de título continua funcionando como sempre."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu telemóvel não conseguiu determinar onde está. Isto precisa de um momento ao ar livre, ou de uma localização que não esteja bloqueada — o campo do título continua a funcionar como sempre."
          }
        }
      }
    },
