    "shareOfRemainderExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Prozente sind Anteile am Rest, keine Bruchteile davon – 100 % bedeutet einen vollen Anteil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The percentages are shares of what's left, not fractions of it — 100% means one full share."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procenty to udziały w tym, co zostało, a nie jego ułamki — 100% oznacza jeden pełny udział."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As porcentagens são partes do que restou, não frações dele — 100% significa uma parte inteira."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As percentagens são partes do que resta, não frações dele — 100% significa uma parte inteira."
