      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein fester Betrag, der vor dem Aufteilen hinzugerechnet wird, damit ihn alle teilen. Lass das Feld leer, um wieder einen Prozentsatz zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A flat sum added on top of the amount before it is split, so everyone shares it. Leave it blank to go back to a percentage."
