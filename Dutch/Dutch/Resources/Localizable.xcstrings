    "That group isn't on this device." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tej grupy nie ma na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse grupo não está neste aparelho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse grupo não está neste dispositivo."
          }
        }
      }
    },
    "That invitation is no longer available. The group may have stopped being shared." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zaproszenie jest już nieaktualne. Grupa mogła przestać być udostępniana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse convite não está mais disponível. O grupo pode ter parado de ser compartilhado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse convite já não está disponível. O grupo pode ter deixado de ser partilhado."
          }
        }
      }
    },
    "That is %@ more than the amount above." : {
      "comment" : "Shown when the contributions typed for several payers come to more than the expense. The placeholder is a formatted money amount.\nShown when the exact amounts typed against a split come to more than the expense. The placeholder is a formatted money amount.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To o %@ więcej niż kwota powyżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é %@ a mais que o valor acima."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é %@ a mais do que o valor acima."
          }
        }
      }
    },
    "That is more than the %@ outstanding." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To więcej niż pozostałe %@ do zapłaty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é mais do que os %@ pendentes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso é mais do que os %@ pendentes."
          }
        }
      }
    },
    "That member is no longer in this group." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tej osoby nie ma już w tej grupie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa pessoa não está mais neste grupo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa pessoa já não está neste grupo."
          }
        }
      }
    },
    "That purchase couldn't be completed." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się dokończyć zakupu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir essa compra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível concluir essa compra."
          }
        }
      }
    },
    "That purchase couldn't be set up. Please try again." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przygotować zakupu. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível preparar essa compra. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível preparar essa compra. Tenta novamente."
          }
        }
      }
    },
    "That quantity isn't available." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta ilość jest niedostępna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa quantidade não está disponível."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa quantidade não está disponível."
          }
        }
      }
    },
    "The amounts add up to the total." : {
      "comment" : "Shown when every member's exact amount has been typed and they sum to the expense exactly.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwoty sumują się do całości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores somam o total."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores somam o total."
          }
        }
      }
    },
    "The amounts use up the total, so everybody else pays nothing." : {
      "comment" : "Shown when the exact amounts already come to the whole expense while other members are still in the split.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwoty wyczerpują całość, więc pozostali nie płacą nic."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores esgotam o total, então ninguém mais paga nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os valores esgotam o total, por isso mais ninguém paga nada."
          }
        }
      }
    },
    "The App Store couldn't be reached. Check your connection and try again." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można połączyć się z App Store. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível conectar à App Store. Verifique sua conexão e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ligar à App Store. Verifica a tua ligação e tenta novamente."
          }
        }
      }
    },
    "The App Store couldn't complete that right now. Please try again." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store nie może teraz tego dokończyć. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não conseguiu concluir isso agora. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A App Store não conseguiu concluir isso agora. Tenta novamente."
          }
        }
      }
    },
    "the group" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bez nazwy"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o grupo"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o grupo"
          }
        }
      }
    },
    "The other payers will be saved as separate expenses on the same date, and this one reduced to its payer's part." : {
      "comment" : "Shown when editing an expense and adding further payers, warning that saving will create new expenses and shrink this one.",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostali płatnicy zostaną zapisani jako osobne wydatki z tą samą datą, a ten zostanie zmniejszony do części swojego płatnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os outros pagadores serão salvos como despesas separadas na mesma data, e esta será reduzida à parte do seu pagador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os outros pagadores serão guardados como despesas separadas na mesma data, e esta será reduzida à parte do seu pagador."
          }
        }
      }
    },
    "This also removes %@ they paid for and re-splits %@ between everyone left. Balances change." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This also removes %1$@ they paid for and re-splits %2$@ between everyone left. Balances change."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa to również opłacone przez nich wydatki (%1$@) i dzieli na nowo współdzielone wydatki (%2$@) między pozostałe osoby. Bilanse się zmienią."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso também remove %1$@ que essa pessoa pagou e redivide %2$@ entre as pessoas restantes. Os saldos vão mudar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto também remove %1$@ que essa pessoa pagou e redivide %2$@ entre as pessoas restantes. Os saldos vão mudar."
          }
        }
      }
    },
    "This also removes %@ they paid for, and recalculates everyone's balance." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa to również opłacone przez nich wydatki (%@) i przelicza bilanse wszystkich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso também remove %@ que essa pessoa pagou, e recalcula o saldo de todos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto também remove %@ que essa pessoa pagou, e recalcula o saldo de todos."
          }
        }
      }
    },
    "This Apple Account isn't allowed to sync with iCloud." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To konto Apple nie ma uprawnień do synchronizacji z iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta Apple não tem permissão para sincronizar com o iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta Apple não tem permissão para sincronizar com o iCloud."
          }
        }
      }
    },
    "This device isn't allowed to make that purchase." : {
      "localizations" : {
        "pl" : {
