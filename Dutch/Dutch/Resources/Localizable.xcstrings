        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch potrzebuje dostępu do lokalizacji, aby zaproponować miejsca w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
