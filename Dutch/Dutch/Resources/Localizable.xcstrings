    "percentageSplitExplanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% is a full share — a 51% off fare is 49%, and two people sharing one hotel room are 50% each. The amounts beside each name always add up to the total."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% to całość kosztów — 51% ulgi to 49%, a dwie osoby dzielące jeden pokój hotelowy to 50% dla każdej. Kwoty przy każdym imieniu zawsze sumują się do kwoty całkowitej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% é uma parte inteira — uma tarifa com 51% de desconto é 49%, e duas pessoas dividindo um quarto de hotel ficam com 50% cada. Os valores ao lado de cada nome sempre somam o total."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100% é uma parte inteira — uma tarifa com 51% de desconto é 49%, e duas pessoas a dividir um quarto de hotel ficam com 50% cada uma. Os valores ao lado de cada nome somam sempre o total."
          }
        }
      }
    },
