    "qrInvitationInstructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only people you invite can join, so scanning this code won't work on its own. Use Invite People, and allow anyone with the link from there."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołączyć mogą tylko osoby, które zaprosisz, więc samo zeskanowanie tego kodu nie zadziała. Użyj opcji „Zaproś ludzi” i zezwól tam na dołączanie każdemu, kto ma link."
          }
        }
      }
    },
    "qrScanningInstructions" : {
      "extractionState" : "manual",
