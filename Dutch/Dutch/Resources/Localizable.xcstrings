        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna grupa jest darmowa. Odblokuj dowolną liczbę grup jednorazową płatnością — dołączanie do grup utworzonych przez innych jest zawsze darmowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
