    "NSCameraUsageDescription" : {
      "comment" : "Why the app asks for the camera. iOS shows this in the permission alert; the English source is INFOPLIST_KEY_NSCameraUsageDescription.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch uses the camera to scan a group's QR code so you can join it."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch używa aparatu, aby zeskanować kod QR grupy i dołączyć do niej."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Why the app asks for location. iOS shows this in the permission alert; the English source is INFOPLIST_KEY_NSLocationWhenInUseUsageDescription.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch reads where you are once, when you tap Nearby on an expense, to suggest the cafés and restaurants around you as its title."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dutch odczytuje Twoje położenie jednorazowo, gdy dotkniesz przycisku „W pobliżu” przy wydatku, aby zaproponować pobliskie kawiarnie i restauracje jako jego tytuł."
          }
        }
      }
    }
  },
  "version" : "1.0"
